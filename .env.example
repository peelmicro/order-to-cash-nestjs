# ═══════════════════════════════════════════════════════════════════════════
# Order-To-Cash — environment template.
#
# Copy to `.env` and adjust as needed:
#   cp .env.example .env
#
# `.env` is git-ignored (see .gitignore); `.env.example` is the checked-in
# source of truth for every variable this project reads, at every phase.
# Ports on the left of "host:container" mappings below are host ports — change
# them here if they collide with something already running on your machine.
# ═══════════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────────
# Timezone used by every container's clock and log timestamps.
TZ=Europe/Madrid
# docker-compose project name prefix, so containers/volumes/networks are
# namespaced and don't collide with other projects on the same machine.
COMPOSE_PROJECT_NAME=otc

# ── MySQL (apps/orders, apps/fulfillment, apps/billing, n8n) ────────────────
# Root credential — used only for admin tasks and container init, never by
# application services.
MYSQL_ROOT_PASSWORD=otc_root_dev_password
# Application user, granted on all four databases by
# infra/mysql/init/01-create-databases.sh (a .sh init script, so this value
# is read straight from the container environment — no drift possible).
MYSQL_USER=otc_app
MYSQL_PASSWORD=otc_app_dev_password
# MYSQL_DATABASE is the one database the mysql image auto-grants MYSQL_USER
# on before init scripts run; the init script extends the grant to the rest.
MYSQL_DATABASE=otc_orders
MYSQL_HOST_PORT=3306
# Per-service logical database names (database-per-service — see CLAUDE.md).
# Consumed by infra/mysql/init/01-create-databases.sh (single source of
# truth for these names, no hardcoded duplicate).
MYSQL_DB_ORDERS=otc_orders
MYSQL_DB_FULFILLMENT=otc_fulfillment
MYSQL_DB_BILLING=otc_billing
MYSQL_DB_N8N=n8n
# Host each service's Drizzle client/migration runner connects to when run
# from the CLI (via `pnpm dev:<app>` or `pnpm db:migrate:<app>`) against the
# compose MySQL, which publishes MYSQL_HOST_PORT on localhost. Only used
# outside a container — a future in-compose app service reaches MySQL by its
# service name instead.
ORDERS_DB_HOST=localhost
FULFILLMENT_DB_HOST=localhost
BILLING_DB_HOST=localhost

# ── MongoDB (read models) ────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=otc_mongo_root
MONGO_INITDB_ROOT_PASSWORD=otc_mongo_dev_password
MONGO_HOST_PORT=27017
# Host apps/projector's and apps/seed's Mongo client connects to when run
# from the CLI against the compose MongoDB (same "outside a container"
# pattern as ORDERS_DB_HOST etc above).
MONGO_HOST=localhost
# The one logical database the projector writes its `order_timeline`
# collection into — no per-service split here, the read model is a single
# store by design (domain-model.md §1 "Projector").
MONGO_DB_READMODEL=otc_read_model

# ── Kafka (fact stream, KRaft single-node — no ZooKeeper) ───────────────
# Internal listener: how other containers reach the broker, by service name.
KAFKA_INTERNAL_HOST=kafka
KAFKA_INTERNAL_PORT=29092
# External listener: how the host machine (and tools run from it) reach the
# broker. Must stay 9092 unless you also change the advertised listener below.
KAFKA_HOST_PORT=9092
# Controller listener, KRaft-internal only, never exposed to the host.
KAFKA_CONTROLLER_PORT=9093
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Topic shape applied by infra/kafka/create-topics.sh (the `kafka-init`
# service / `pnpm kafka:topics`) to every spec-derived fact + .dlq topic.
# Partitions: future consumer-group parallelism headroom. Safe to raise
# because every producer keys these topics by `correlationId` (the order
# id), so Kafka's default partitioner always routes one order's facts to the
# same partition regardless of partition count — the saga's per-order
# ordering guarantee never depends on this number.
KAFKA_TOPIC_PARTITIONS=6
# Replication factor MUST stay 1 — this is a single-node broker (no
# ZooKeeper, no additional brokers), so there is nowhere else to replicate
# to; anything higher fails topic creation outright.
KAFKA_TOPIC_REPLICATION_FACTOR=1

# ── Redpanda Console (Kafka UI) ──────────────────────────────────────────
REDPANDA_CONSOLE_HOST_PORT=8080

# ── Outbox relay (apps/orders — outbox_and_idempotency feature, design.md
#    §8. Consumed by outbox-relay.config.ts / kafka.config.ts) ────────────
# Master switch: a deployment that scales the Orders service out can still
# run exactly one relay by flipping this on the single replica meant to run
# it.
OUTBOX_RELAY_ENABLED=true
# How often the relay starts a new poll cycle, once the previous one has
# settled (self-scheduling setTimeout, never setInterval — see
# outbox-relay.service.ts). Small enough that the demo feels immediate,
# large enough not to hammer MySQL when idle.
OUTBOX_POLL_INTERVAL_MS=250
# Max unpublished records claimed per poll cycle (SELECT ... FOR UPDATE
# SKIP LOCKED ... LIMIT). Bounds how long the claim transaction stays open.
OUTBOX_BATCH_SIZE=100
# The producer's acknowledgement budget for one batch; also bounds the open
# claim transaction (design.md §5.2).
OUTBOX_PUBLISH_TIMEOUT_MS=5000
# Kafka bootstrap servers for the relay's kafkajs producer, from OUTSIDE a
# container (same "host access" pattern as ORDERS_DB_HOST above — a future
# in-compose apps/orders container reaches Kafka via KAFKA_INTERNAL_HOST
# instead).
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=otc-orders

# ── NATS (RPC transport — core only, JetStream deliberately OFF; see
#    specs/shared/asyncapi.yaml — Kafka owns durability, not NATS) ──────────
NATS_CLIENT_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
# NATS server URL(s) for apps/orders, from OUTSIDE a container (same "host
# access" pattern as KAFKA_BROKERS/ORDERS_DB_HOST above — a future
# in-compose apps/orders container reaches NATS by its service name
# instead). Consumed by nats.config.ts: both the `orders.create`
# @nestjs/microservices responder (main.ts) and the outbound
# `fulfillment.stock.check` client (nats-stock-availability.adapter.ts).
NATS_URL=nats://localhost:4222
# How long the outbound `fulfillment.stock.check` RPC call waits for a reply
# before it is treated as a timeout (orders_acceptance feature) — a timeout
# is a legitimate, handled answer (saga.md §1), never a hang.
STOCK_CHECK_TIMEOUT_MS=5000

# ── Observability: OTel Collector → Jaeger v2, Prometheus, Grafana ─────────
# OTLP ingress, used by every service's tracing SDK.
OTEL_COLLECTOR_GRPC_HOST_PORT=4317
OTEL_COLLECTOR_HTTP_HOST_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Jaeger v2 UI only — its own OTLP ports stay internal-only (the collector
# already owns 4317/4318 on the host; see docker-compose.infra.yml).
JAEGER_UI_HOST_PORT=16686
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=otc_grafana_dev_password

# ── n8n (workflow automation, REST-only against the Gateway — see
#    specs/shared/n8n-workflows.md) ─────────────────────────────────────────
N8N_HOST_PORT=5678
N8N_ENCRYPTION_KEY=otc_n8n_dev_encryption_key_change_me
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=otc_n8n_dev_password

# ── SonarQube (opt-in via `pnpm dc:up:sonar` — compose profile "sonar", off
#    by default to save ~1.5 GB RAM) ────────────────────────────────────────
SONARQUBE_HOST_PORT=9000

# ── Application feature flags (consumed from phase 23 onwards; declared now
#    so the template is complete on day one) ───────────────────────────────
# Simulated credit-check failure rate, 0.0–1.0. 0 = credit checks always pass.
CREDIT_FAILURE_RATE=0

# ── Mailtrap (outbound notification emails — placeholders, fill in your own
#    sandbox inbox credentials from mailtrap.io) ────────────────────────────
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=replace_me
MAILTRAP_PASSWORD=replace_me
MAILTRAP_FROM_EMAIL=no-reply@order-to-cash.example

# ── JWT (Gateway authentication) ─────────────────────────────────────────
JWT_SECRET=otc_dev_jwt_secret_change_me
JWT_EXPIRES_IN=1h
JWT_ISSUER=order-to-cash

# ── Application services (apps/*, run from the CLI via `pnpm dev:<app>` —
#    see monorepo_scaffold. Also the ports each app's src/main.ts falls back
#    to when the matching var is unset, so the numbers below MUST stay in
#    sync with apps/*/src/main.ts) ───────────────────────────────────────
GATEWAY_PORT=3001
ORDERS_PORT=3002
FULFILLMENT_PORT=3003
BILLING_PORT=3004
NOTIFICATIONS_PORT=3005
PROJECTOR_PORT=3006
WEB_PORT=3000

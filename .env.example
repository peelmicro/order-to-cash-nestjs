# ═══════════════════════════════════════════════════════════════════════════
# Order-To-Cash — environment template.
#
# Copy to `.env` and adjust as needed:
#   cp .env.example .env
#
# `.env` is git-ignored (see .gitignore); `.env.example` is the checked-in
# source of truth for every variable this project reads, at every phase.
# Ports on the left of "host:container" mappings below are host ports — change
# them here if they collide with something already running on your machine.
# ═══════════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────────
# Timezone used by every container's clock and log timestamps.
TZ=Europe/Madrid
# docker-compose project name prefix, so containers/volumes/networks are
# namespaced and don't collide with other projects on the same machine.
COMPOSE_PROJECT_NAME=otc

# ── MySQL (apps/orders, apps/fulfillment, apps/billing, apps/notifications) ─
# Root credential — used only for admin tasks and container init, never by
# application services.
MYSQL_ROOT_PASSWORD=otc_root_dev_password
# Application user, granted on all four databases by
# infra/mysql/init/01-create-databases.sh (a .sh init script, so this value
# is read straight from the container environment — no drift possible).
MYSQL_USER=otc_app
MYSQL_PASSWORD=otc_app_dev_password
# MYSQL_DATABASE is the one database the mysql image auto-grants MYSQL_USER
# on before init scripts run; the init script extends the grant to the rest.
MYSQL_DATABASE=otc_orders
MYSQL_HOST_PORT=3306
# Per-service logical database names (database-per-service — see CLAUDE.md).
# Consumed by infra/mysql/init/01-create-databases.sh (single source of
# truth for these names, no hardcoded duplicate).
MYSQL_DB_ORDERS=otc_orders
MYSQL_DB_FULFILLMENT=otc_fulfillment
MYSQL_DB_BILLING=otc_billing
# notifications_service re-review (N1/N2): a durable processed_events
# ledger, on its own logical database — never shared with another service's
# schema.
MYSQL_DB_NOTIFICATIONS=otc_notifications
# MYSQL_DB_N8N intentionally NOT here — n8n never connects to MySQL (see the
# n8n section below); this variable was removed in the n8n review fix
# (progress/impl_n8n_workflows.md, "Review fixes") rather than documented as
# a knob that does nothing.
# Host each service's Drizzle client/migration runner connects to when run
# from the CLI (via `pnpm dev:<app>` or `pnpm db:migrate:<app>`) against the
# compose MySQL, which publishes MYSQL_HOST_PORT on localhost. Only used
# outside a container — a future in-compose app service reaches MySQL by its
# service name instead.
ORDERS_DB_HOST=localhost
FULFILLMENT_DB_HOST=localhost
BILLING_DB_HOST=localhost
NOTIFICATIONS_DB_HOST=localhost

# ── MongoDB (read models) ────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=otc_mongo_root
MONGO_INITDB_ROOT_PASSWORD=otc_mongo_dev_password
MONGO_HOST_PORT=27017
# Host apps/projector's and apps/seed's Mongo client connects to when run
# from the CLI against the compose MongoDB (same "outside a container"
# pattern as ORDERS_DB_HOST etc above).
MONGO_HOST=localhost
# The one logical database the projector writes its `order_timeline`
# collection into — no per-service split here, the read model is a single
# store by design (domain-model.md §1 "Projector").
MONGO_DB_READMODEL=otc_read_model

# ── Kafka (fact stream, KRaft single-node — no ZooKeeper) ───────────────
# Internal listener: how other containers reach the broker, by service name.
KAFKA_INTERNAL_HOST=kafka
KAFKA_INTERNAL_PORT=29092
# External listener: how the host machine (and tools run from it) reach the
# broker. Must stay 9092 unless you also change the advertised listener below.
KAFKA_HOST_PORT=9092
# Controller listener, KRaft-internal only, never exposed to the host.
KAFKA_CONTROLLER_PORT=9093
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Topic shape applied by infra/kafka/create-topics.sh (the `kafka-init`
# service / `pnpm kafka:topics`) to every spec-derived fact + .dlq topic.
# Partitions: future consumer-group parallelism headroom. Safe to raise
# because every producer keys these topics by `correlationId` (the order
# id), so Kafka's default partitioner always routes one order's facts to the
# same partition regardless of partition count — the saga's per-order
# ordering guarantee never depends on this number.
KAFKA_TOPIC_PARTITIONS=6
# Replication factor MUST stay 1 — this is a single-node broker (no
# ZooKeeper, no additional brokers), so there is nowhere else to replicate
# to; anything higher fails topic creation outright.
KAFKA_TOPIC_REPLICATION_FACTOR=1

# ── Redpanda Console (Kafka UI) ──────────────────────────────────────────
REDPANDA_CONSOLE_HOST_PORT=8080

# ── Outbox relay (apps/orders — outbox_and_idempotency feature, design.md
#    §8. Consumed by outbox-relay.config.ts / kafka.config.ts) ────────────
# Master switch: a deployment that scales the Orders service out can still
# run exactly one relay by flipping this on the single replica meant to run
# it.
OUTBOX_RELAY_ENABLED=true
# How often the relay starts a new poll cycle, once the previous one has
# settled (self-scheduling setTimeout, never setInterval — see
# outbox-relay.service.ts). Small enough that the demo feels immediate,
# large enough not to hammer MySQL when idle.
OUTBOX_POLL_INTERVAL_MS=250
# Max unpublished records claimed per poll cycle (SELECT ... FOR UPDATE
# SKIP LOCKED ... LIMIT). Bounds how long the claim transaction stays open.
OUTBOX_BATCH_SIZE=100
# The producer's acknowledgement budget for one batch; also bounds the open
# claim transaction (design.md §5.2).
OUTBOX_PUBLISH_TIMEOUT_MS=5000
# Kafka bootstrap servers for the relay's kafkajs producer, from OUTSIDE a
# container (same "host access" pattern as ORDERS_DB_HOST above — a future
# in-compose apps/orders container reaches Kafka via KAFKA_INTERNAL_HOST
# instead).
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=otc-orders
# Fulfillment's own outbox relay reads the same KAFKA_BROKERS above but a
# DISTINCT client id — two services must not silently share one
# (fulfillment_stock design.md §12).
FULFILLMENT_KAFKA_CLIENT_ID=otc-fulfillment
# Billing's own outbox relay reads the same KAFKA_BROKERS above but a
# DISTINCT client id — a third service must not silently share
# KAFKA_CLIENT_ID with Orders (billing_credit design.md §14).
BILLING_KAFKA_CLIENT_ID=otc-billing
# Notifications' own Kafka CONSUMER (notifications_service, N10) — reads the
# same KAFKA_BROKERS above, a DISTINCT client id, and its OWN consumer
# group. WARNING: changing NOTIFICATIONS_CONSUMER_GROUP creates a brand-new
# consumer group with no committed offsets — combined with a non-durable
# ledger this once caused a real Mailtrap rate-limit storm (see
# progress/impl_notifications_service.md's N3 correction). The service's
# durable `processed_events` table (otc_notifications, MYSQL_DB_NOTIFICATIONS
# above) makes a duplicate SEND still impossible even so, but changing this
# value is still not routine — do it deliberately, not by accident.
NOTIFICATIONS_KAFKA_CLIENT_ID=otc-notifications
NOTIFICATIONS_CONSUMER_GROUP=notifications

# Projector's own Kafka consumer identity (projector_read_model, task A3) —
# the NOTIFICATIONS_* pair's exact shape. Unlike Notifications, the
# projector subscribes `fromBeginning: true` (design.md §8.1/PR5): it is a
# derived store, and replaying every topic from the start is how it is
# built and how it stays reconstructible.
PROJECTOR_KAFKA_CLIENT_ID=otc-projector
PROJECTOR_CONSUMER_GROUP=projector

# ── NATS (RPC transport — core only, JetStream deliberately OFF; see
#    specs/shared/asyncapi.yaml — Kafka owns durability, not NATS) ──────────
NATS_CLIENT_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222
# NATS server URL(s) for apps/orders, from OUTSIDE a container (same "host
# access" pattern as KAFKA_BROKERS/ORDERS_DB_HOST above — a future
# in-compose apps/orders container reaches NATS by its service name
# instead). Consumed by nats.config.ts: both the `orders.create`
# @nestjs/microservices responder (main.ts) and the outbound
# `fulfillment.stock.check` client (nats-stock-availability.adapter.ts).
NATS_URL=nats://localhost:4222
# How long the outbound `fulfillment.stock.check` RPC call waits for a reply
# before it is treated as a timeout (orders_acceptance feature) — a timeout
# is a legitimate, handled answer (saga.md §1), never a hang.
STOCK_CHECK_TIMEOUT_MS=5000

# ── order_saga_orchestrator — saga command retry (SO4) and sweeper (SO5) ───
# Per-attempt NATS request budget for the five outbound saga commands
# (stock.reserve/release, despatch.create, credit.hold, invoice.issue) —
# mirrors STOCK_CHECK_TIMEOUT_MS above (saga-command-dispatcher.ts).
SAGA_COMMAND_TIMEOUT_MS=5000
# In-line attempts before a command parks. Worst case with the two defaults
# below: 3 x 5000ms + 500ms + 1000ms = 16.5s — deliberately under Kafka's
# 30s session timeout, though this dispatch runs OFF the consumer's await
# chain (design.md §3.2) so it bounds the dispatch/sweep cycle, not the
# partition.
SAGA_COMMAND_MAX_ATTEMPTS=3
# Base backoff between in-line attempts; exponential x2 (500ms, 1000ms).
SAGA_COMMAND_BACKOFF_MS=500
# Master switch for the sweeper — the durability backstop that re-issues
# `pending` rows a crashed fast-path hop never dispatched (SO3), and retries
# `parked` rows on a capped schedule indefinitely (SO5).
SAGA_SWEEPER_ENABLED=true
# How often the sweeper starts a new claim cycle, once the previous one has
# settled (self-scheduling setTimeout, same discipline as the outbox relay).
SAGA_SWEEPER_INTERVAL_MS=30000
# How long a `pending` row must sit uncollected (the SO3 crash window: a
# committed enqueue whose in-process EventBus->@Saga hop never ran) before
# the sweeper treats it as due, independent of any parked backoff.
SAGA_PENDING_GRACE_MS=10000
# The cap on a parked command's capped-exponential retry schedule (30s x
# 2^parkCycles, capped here) — parking never gives up (design.md §6.4); the
# cap only bounds how stale the retry interval can get.
SAGA_PARK_RETRY_CAP_MS=900000

# ── Observability: OTel Collector → Jaeger v2, Prometheus, Grafana ─────────
# OTLP ingress, used by every service's tracing SDK.
OTEL_COLLECTOR_GRPC_HOST_PORT=4317
OTEL_COLLECTOR_HTTP_HOST_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Jaeger v2 UI only — its own OTLP ports stay internal-only (the collector
# already owns 4317/4318 on the host; see docker-compose.infra.yml).
JAEGER_UI_HOST_PORT=16686
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=otc_grafana_dev_password

# ── Mailpit (self-hosted SMTP sink + web inbox) ────────────────────────────
# Replaced Mailtrap in phase 24's run-up: the sandbox free tier is 50 test
# emails/month and this system sends ~4 per order, so the quota was exhausted
# and 728 facts were dead-lettered before anyone noticed. Mailpit needs no
# account, has no quota, and removes an SMTP password from this file
# entirely. Any SMTP provider still works — point SMTP_* at it (see README).
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
# Mailpit keeps only the most recent N messages (it is a demo sink, not an
# archive); raise it if a long demo run needs more history.
MAILPIT_MAX_MESSAGES=500

# ── n8n (workflow automation, REST-only against the Gateway — see
#    specs/shared/n8n-workflows.md) ─────────────────────────────────────────
# The n8n container itself is behind the "n8n" compose profile — `pnpm
# dc:up:infra`/`dc:up:apps` pass --profile n8n by default (n8n present,
# today's behaviour unchanged); `pnpm dc:up:infra:no-n8n`/`dc:up:apps:no-n8n`
# omit it (specs/shared/n8n-workflows.md §7.1's "no workflow engine at all").
N8N_HOST_PORT=5678
N8N_ENCRYPTION_KEY=otc_n8n_dev_encryption_key_change_me
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=otc_n8n_dev_password
# n8n 2.36.2 dropped MySQL support upstream (its DB_TYPE only accepts
# sqlite/postgresdb), so it runs on its own embedded SQLite file inside the
# n8n_data volume — there is no MYSQL_DB_N8N variable here and no MySQL
# credential in this container's environment (docker-compose.infra.yml no
# longer uses `env_file: [.env]` for n8n/n8n-init — see that file's n8n:
# service comment and progress/impl_n8n_workflows.md, "Review fixes").

# Master switch (specs/shared/n8n-workflows.md §7.1, §2.5). false: the
# n8n-init one-shot container still runs but imports nothing — the n8n
# container itself keeps running (use the "n8n" compose profile above to
# remove the engine entirely instead).
N8N_WORKFLOWS_ENABLED=true

# The Gateway base URL every workflow calls (specs/shared/n8n-workflows.md
# §1, §2.5) — the ONE value that changes when this spec is ported to
# assessments #8/#9. docker-compose.infra.yml's n8n/n8n-init services
# override this to the in-network address (http://gateway:${GATEWAY_PORT})
# regardless of what is set here; this default is for running a workflow's
# JS logic from the host (e.g. via `n8n execute`) outside the compose
# network.
OTC_GATEWAY_URL=http://localhost:3001
# Per-call HTTP timeout every workflow's requests use.
OTC_REQUEST_TIMEOUT_MS=10000
# Workflow credentials are GATEWAY_OPERATOR_USERNAME/PASSWORD above (feature
# 25) — no separate n8n-only login, so there is exactly one operator
# identity for a human, the UI and every demo workflow alike.
#
# The four *_INTERVAL_SECONDS variables below and BURST_WEBHOOK_PATH are
# genuinely read by their trigger nodes (n8n expressions against $env, e.g.
# `={{ Number($env.ORDER_GENERATOR_INTERVAL_SECONDS) || 45 }}`) — verified
# live: a throwaway container with ORDER_GENERATOR_INTERVAL_SECONDS=11 fired
# exactly every 11s, and BURST_WEBHOOK_PATH=my-custom-path served 200 on
# /webhook/my-custom-path while the hardcoded default 404'd (see
# progress/impl_n8n_workflows.md, "Review fixes"). Same caveat as any other
# activation change on this n8n version (see the auto-activation note above
# and README.md): editing one of these in `.env` only takes effect the next
# time the workflow is (re-)published AND n8n is restarted — `docker compose
# restart n8n` after `docker compose up` picks up the new value.

# Workflow 1 — order generator (specs/shared/n8n-workflows.md §3.4).
ORDER_GENERATOR_ENABLED=true
ORDER_GENERATOR_INTERVAL_SECONDS=45
ORDER_GENERATOR_ORDERS_PER_RUN=1
ORDER_GENERATOR_COMPENSATION_RATIO=0.15
ORDER_GENERATOR_MAX_LINES=4
ORDER_GENERATOR_MAX_UNITS=10
# Comma-separated codes to restrict to, e.g. CarrefourEs,AldiDe. Empty = all.
ORDER_GENERATOR_RETAILERS=
ORDER_GENERATOR_COMPANIES=
ORDER_GENERATOR_CATALOG_TTL_SECONDS=600

# Workflow 2 — payment robot, "the bank" (specs/shared/n8n-workflows.md §4.3).
PAYMENT_ROBOT_ENABLED=true
PAYMENT_ROBOT_INTERVAL_SECONDS=120
# Minimum invoice age before it is paid. Raise it to demonstrate the
# `invoiced` waiting state; set 0 to pay (almost) immediately.
PAYMENT_AGE_MINUTES=2
PAYMENT_ROBOT_BATCH_SIZE=10
# Restrict to certain retailers, e.g. to leave one permanently unpaid for
# the demo. Empty = all.
PAYMENT_ROBOT_RETAILERS=

# Workflow 3 — stock replenishment (specs/shared/n8n-workflows.md §5.3).
STOCK_REPLENISH_ENABLED=true
STOCK_REPLENISH_INTERVAL_SECONDS=300
STOCK_REPLENISH_TOP_UP_UNITS=100
STOCK_REPLENISH_BATCH_SIZE=50
# Restrict to certain companies — leave one starved on purpose to keep the
# stock_rejected path demoable. Empty = all.
STOCK_REPLENISH_COMPANIES=

# Workflow 4 — burst, manual webhook (specs/shared/n8n-workflows.md §6.3).
# Fire it with: curl -X POST http://localhost:5678/webhook/otc-burst
BURST_ENABLED=true
BURST_ORDER_COUNT=20
BURST_CONCURRENCY=5
BURST_COMPENSATION_RATIO=0.20
BURST_WEBHOOK_PATH=otc-burst

# ── SonarQube (opt-in via `pnpm dc:up:sonar` — compose profile "sonar", off
#    by default to save ~1.5 GB RAM) ────────────────────────────────────────
SONARQUBE_HOST_PORT=9000

# ── Application feature flags (consumed from phase 23 onwards; declared now
#    so the template is complete on day one) ───────────────────────────────
# Simulated credit-check failure rate, 0.0–1.0. 0 = credit checks always pass.
CREDIT_FAILURE_RATE=0

# ── SMTP (outbound notification emails) — provider-neutral: SMTP_HOST/
#    SMTP_PORT/SMTP_USER/SMTP_PASSWORD point apps/notifications' adapter
#    (apps/notifications/src/infrastructure/notification/smtp.config.ts) at
#    ANY SMTP server. Defaults below point at Mailpit
#    (docker-compose.infra.yml's `mailpit` service — self-hosted, no
#    account, no quota, started by `pnpm dc:up:infra`), replacing Mailtrap
#    (whose Email Sandbox free tier — 50 messages/month — was exhausted mid-
#    demo and dead-lettered 728 facts before anyone noticed; see
#    progress/impl_mailpit_migration.md). Mailpit does not enforce SMTP
#    AUTH by default, so SMTP_USER/SMTP_PASSWORD below are placeholders that
#    Mailpit accepts as-is — no account needed. To use a real provider
#    instead (Mailtrap included), point SMTP_HOST/SMTP_PORT at it and set
#    SMTP_USER/SMTP_PASSWORD to real credentials.
#    SMTP_HOST is `localhost` here (outside-container default, same
#    "outside vs inside compose" split as MONGO_HOST/NATS_URL above);
#    docker-compose.apps.yml overrides it to `mailpit` for the notifications
#    container. ─────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=mailpit
SMTP_PASSWORD=mailpit
SMTP_FROM_EMAIL=no-reply@order-to-cash.example

# ── JWT (Gateway authentication) ─────────────────────────────────────────
JWT_SECRET=otc_dev_jwt_secret_change_me
JWT_EXPIRES_IN=1h
JWT_ISSUER=order-to-cash

# ── Gateway operator identity (feature 25, gateway_rest_auth — a single,
#    statically-configured operator, domain-model.md §9: not multi-tenant.
#    Review finding F5: was previously an invisible code-level default,
#    with no key here for a deployer to override) ─────────────────────────
GATEWAY_OPERATOR_USERNAME=operator
GATEWAY_OPERATOR_PASSWORD=otc_operator_dev_password_change_me
GATEWAY_OPERATOR_DISPLAY_NAME=Order-To-Cash Operator

# ── Gateway RPC / SSE tuning (feature 25) ─────────────────────────────────
GATEWAY_RPC_TIMEOUT_MS=5000
GATEWAY_SSE_BUFFER_CAPACITY=500
GATEWAY_SSE_PING_INTERVAL_MS=15000
GATEWAY_ISSUED_ORDER_WINDOW_TTL_MS=300000
GATEWAY_ISSUED_ORDER_WINDOW_CAPACITY=10000

# ── Application services (apps/*, run from the CLI via `pnpm dev:<app>` —
#    see monorepo_scaffold. Also the ports each app's src/main.ts falls back
#    to when the matching var is unset, so the numbers below MUST stay in
#    sync with apps/*/src/main.ts) ───────────────────────────────────────
GATEWAY_PORT=3001
ORDERS_PORT=3002
FULFILLMENT_PORT=3003
BILLING_PORT=3004
NOTIFICATIONS_PORT=3005
PROJECTOR_PORT=3006
WEB_PORT=3000

# ── apps/web (feature 29, web_app — Nuxt 4 BFF) ───────────────────────────
# The base URL apps/web's own Nitro SERVER (never the browser — see
# progress/current.md "F14 resolved") uses to proxy every Gateway call and
# attach the real Authorization: Bearer header server-side. Defaults to
# GATEWAY_PORT above when unset, so this key only needs a value if the
# Gateway is reached at a different host/port than this compose stack's own.
GATEWAY_BASE_URL=http://localhost:3001
# Encryption/signing key for the sealed, httpOnly session cookie (h3's
# useSession, apps/web/server/utils/session.ts) that holds the operator's
# JWT server-side. Any string is accepted; production deployments should
# set a real random 32+ character secret, same discipline as JWT_SECRET
# above.
NUXT_SESSION_PASSWORD=otc_web_dev_session_password_change_me_32ch

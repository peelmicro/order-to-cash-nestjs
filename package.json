{
  "name": "order-to-cash-nestjs",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "Order-To-Cash — order lifecycle backbone for a B2B EDI / e-invoicing platform (assessment #7 of a trilogy).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present --no-bail run test:coverage",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "quality": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage",
    "contracts:generate": "pnpm --filter @otc/contracts run generate",
    "contracts:check": "pnpm --filter @otc/contracts run check",
    "db:generate:orders": "pnpm --filter @otc/orders run db:generate",
    "db:migrate:orders": "pnpm --filter @otc/orders run db:migrate",
    "db:generate:fulfillment": "pnpm --filter @otc/fulfillment run db:generate",
    "db:migrate:fulfillment": "pnpm --filter @otc/fulfillment run db:migrate",
    "db:generate:billing": "pnpm --filter @otc/billing run db:generate",
    "db:migrate:billing": "pnpm --filter @otc/billing run db:migrate",
    "seed": "pnpm --filter @otc/seed run seed",
    "dev:gateway": "pnpm --filter @otc/gateway run dev",
    "dev:orders": "pnpm --filter @otc/orders run dev",
    "dev:fulfillment": "pnpm --filter @otc/fulfillment run dev",
    "dev:billing": "pnpm --filter @otc/billing run dev",
    "dev:notifications": "pnpm --filter @otc/notifications run dev",
    "dev:projector": "pnpm --filter @otc/projector run dev",
    "dev:web": "pnpm --filter @otc/web run dev",
    "dc:up:infra": "docker compose -f docker-compose.infra.yml --profile n8n up -d",
    "dc:up:infra:no-n8n": "docker compose -f docker-compose.infra.yml up -d",
    "kafka:topics": "docker compose -f docker-compose.infra.yml run --rm kafka-init",
    "dc:down:infra": "docker compose -f docker-compose.infra.yml --profile n8n down",
    "dc:ps:infra": "docker compose -f docker-compose.infra.yml --profile n8n ps",
    "dc:clean:infra": "docker compose -f docker-compose.infra.yml --profile n8n down -v",
    "dc:logs:infra": "docker compose -f docker-compose.infra.yml logs -f",
    "dc:logs:mysql": "docker compose -f docker-compose.infra.yml logs -f mysql",
    "dc:logs:mongodb": "docker compose -f docker-compose.infra.yml logs -f mongodb",
    "dc:logs:kafka": "docker compose -f docker-compose.infra.yml logs -f kafka",
    "dc:logs:kafka-console": "docker compose -f docker-compose.infra.yml logs -f kafka-console",
    "dc:logs:nats": "docker compose -f docker-compose.infra.yml logs -f nats",
    "dc:logs:otel-collector": "docker compose -f docker-compose.infra.yml logs -f otel-collector",
    "dc:logs:jaeger": "docker compose -f docker-compose.infra.yml logs -f jaeger",
    "dc:logs:prometheus": "docker compose -f docker-compose.infra.yml logs -f prometheus",
    "dc:logs:grafana": "docker compose -f docker-compose.infra.yml logs -f grafana",
    "dc:logs:n8n": "docker compose -f docker-compose.infra.yml logs -f n8n",
    "dc:up:sonar": "docker compose -f docker-compose.infra.yml --profile sonar up -d sonarqube",
    "dc:down:sonar": "docker compose -f docker-compose.infra.yml --profile sonar stop sonarqube",
    "dc:logs:sonarqube": "docker compose -f docker-compose.infra.yml --profile sonar logs -f sonarqube",
    "sonar:scan": "if [ -z \"$SONAR_TOKEN\" ]; then echo 'SONAR_TOKEN is not set. Export a SonarQube user token first (README.md \"SonarQube\" section) e.g.: export SONAR_TOKEN=squ_xxxxxxxx' >&2; exit 1; fi && pnpm run test:coverage && docker run --rm --network otc-net -v \"$PWD:/usr/src\" -e SONAR_TOKEN sonarsource/sonar-scanner-cli -Dsonar.host.url=http://otc-sonarqube:9000",
    "dc:up:apps": "docker compose -f docker-compose.infra.yml -f docker-compose.apps.yml --profile n8n up -d",
    "dc:up:apps:no-n8n": "docker compose -f docker-compose.infra.yml -f docker-compose.apps.yml up -d",
    "dc:down:apps": "docker compose -f docker-compose.infra.yml -f docker-compose.apps.yml --profile sonar --profile n8n down",
    "dc:ps:apps": "docker compose -f docker-compose.infra.yml -f docker-compose.apps.yml --profile sonar --profile n8n ps",
    "dc:clean:apps": "docker compose -f docker-compose.infra.yml -f docker-compose.apps.yml --profile sonar --profile n8n down -v",
    "dc:logs:apps": "docker compose -f docker-compose.infra.yml -f docker-compose.apps.yml logs -f",
    "dc:build:apps": "docker compose -f docker-compose.infra.yml -f docker-compose.apps.yml build",
    "dc:seed": "docker compose -f docker-compose.infra.yml -f docker-compose.apps.yml --profile seed run --rm seed",
    "n8n:import": "bash scripts/import-n8n-workflows.sh",
    "n8n:export": "bash scripts/export-n8n-workflows.sh",
    "media:capture": "node scripts/capture-media.mjs",
    "media:demo": "node scripts/capture-demo.mjs",
    "order:place": "node scripts/place-order.mjs",
    "order:over-limit": "node scripts/place-order.mjs --over-limit",
    "saga:watch": "docker exec otc-mysql sh -c 'mysql -uroot -p\"$MYSQL_ROOT_PASSWORD\" -e \"SELECT order_reference,status,cancellation_reason FROM otc_orders.orders ORDER BY order_reference; SELECT command,status,COUNT(*) n FROM otc_orders.saga_commands GROUP BY command,status\"'",
    "invoice:pay": "node scripts/pay-invoice.mjs",
    "invoice:list": "node scripts/pay-invoice.mjs --list"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/microservices": "catalog:",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "nats": "catalog:",
    "prettier": "^3.9.6",
    "rxjs": "catalog:",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vue-eslint-parser": "^10.4.1"
  }
}

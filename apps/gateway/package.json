{
  "name": "@otc/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsc-watch --noClear -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/cqrs": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@otc/contracts": "workspace:*",
    "@otc/shared-kernel": "workspace:*",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "js-yaml": "catalog:",
    "jsonwebtoken": "catalog:",
    "mongodb": "catalog:",
    "nats": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "swagger-ui-express": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "@testcontainers/mongodb": "catalog:",
    "@testcontainers/nats": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@types/swagger-ui-express": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv-cli": "catalog:",
    "supertest": "catalog:",
    "testcontainers": "catalog:",
    "tsc-watch": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
